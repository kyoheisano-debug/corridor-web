# Corridor pipeline — provider credentials
# Copy to `.env` and fill in. `.env` is gitignored. Never commit real keys.

# --- seedance2.ai (the route this project is contracted on) ---
SEEDANCE2_API_KEY=sk_live_xxxxxxxxxxxxxxxx
# Override only if the api differs from the verified defaults in providers.py:
# SEEDANCE2_BASE_URL=https://seedance2.ai/api
# SEEDANCE2_VIDEO_CREATE=/v1/videos/generations
# SEEDANCE2_IMAGE_CREATE=/v1/images/generations
# SEEDANCE2_TASK_STATUS=/v1/tasks
# SEEDANCE2_VIDEO_MODEL=seedance-2-0
# SEEDANCE2_IMAGE_MODEL=seedance-2-0-image
# SEEDANCE2_USER_AGENT=corridor-pipeline/1.0
# Set to 1 if image-to-video expects a hosted image URL instead of base64:
# SEEDANCE2_IMAGE_AS_URL=1
# NOTE: egress must allow both seedance2.ai (API) and cdn.seedance2.ai (output CDN).

# --- fal.ai (alternative route) ---
FAL_KEY=
# Optional overrides if model ids change:
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v4
FAL_VIDEO_MODEL=fal-ai/bytedance/seedance/v1/pro

# --- kie.ai (alternative) ---
KIE_API_KEY=

# --- ByteDance Volcengine (official Seedance API) ---
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
